        function draw() {
            ctx.clearRect(0, 0, cw, ch);
            ctx.save();
            if (shakeTime > 0) ctx.translate((Math.random() - 0.5) * 12, (Math.random() - 0.5) * 12);
            
            ctx.fillStyle = gameState === 'BOSS_FIGHT' ? (bossPhase === 2 ? 'rgba(50, 0, 0, 0.6)' : 'rgba(30, 0, 0, 0.4)') : 'rgba(255, 255, 255, 0.04)';
            ctx.fillRect(0, 0, cw, ch);

            if (gameState !== 'BOSS_FIGHT') {
                drawPipes();
            } else {
                drawBattleBox(); 
            }

            for (let pt of particles) {
                if (pt.type === 'bubble' || pt.type === 'bg_bubble') {
                    ctx.fillStyle = `rgba(255, 255, 255, ${pt.alpha})`;
                    ctx.beginPath(); ctx.arc(pt.x, pt.y, pt.radius, 0, Math.PI * 2); ctx.fill();
                } else if (pt.type === 'star') {
                    ctx.fillStyle = pt.color; ctx.globalAlpha = pt.alpha; ctx.font = `${pt.size}px Arial`;
                    ctx.fillText('✨', pt.x, pt.y); ctx.globalAlpha = 1.0; 
                }
            }

            drawItems(); 
            
            if (gameState === 'BOSS_FIGHT') {
                drawBoss();
                drawBossBullets();
            }

            drawFish();

            for (let ft of floatingTexts) {
                ctx.fillStyle = ft.color;
                ctx.globalAlpha = ft.alpha;
                ctx.font = 'bold 20px Arial';
                ctx.textAlign = 'center';
                ctx.fillText(ft.text, ft.x, ft.y);
                ctx.globalAlpha = 1.0;
            }

            if (gameState !== 'START') {
                ctx.fillStyle = '#ffffff'; ctx.font = 'bold 32px Arial'; ctx.textAlign = 'right';
                ctx.fillText(score.toString(), cw - 65, 45);
                ctx.font = '28px Arial';
                let scoreWidth = ctx.measureText(score.toString()).width;
                ctx.fillText('🍚', cw - 65 - scoreWidth - 10, 45);
            }

            if (gameState === 'BOSS_FIGHT') {
                ctx.textAlign = 'left'; ctx.font = '24px Arial';
                for (let i = 0; i < fish.maxHp; i++) {
                    ctx.fillStyle = i < fish.hp ? '#e74c3c' : '#7f8c8d';
                    ctx.fillText('♥', 20 + i * 30, 45);
                }

                ctx.font = '12px Arial';
                ctx.fillStyle = fish.dashCooldown <= 0 ? '#2ecc71' : '#e67e22';
                ctx.fillText(fish.dashCooldown <= 0 ? '【點擊可閃避】' : `閃避冷卻中...`, 20, 70);

                if (boss) {
                    ctx.fillStyle = '#2c3e50';
                    ctx.fillRect(cw / 2 - 100, 20, 200, 15);
                    ctx.fillStyle = bossPhase === 2 ? '#e74c3c' : '#f1c40f';
                    ctx.fillRect(cw / 2 - 100, 20, 200 * (boss.hp / BOSS_MAX_HP), 15);
                    ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
                    ctx.strokeRect(cw / 2 - 100, 20, 200, 15);
                    
                    ctx.fillStyle = '#fff'; ctx.font = 'bold 14px Arial'; ctx.textAlign = 'center';
                    ctx.fillText(bossPhase === 2 ? '⚠️ 骷髏魚王【狂暴階段】' : '骷髏魚王', cw / 2, 15);
                }
            }

            if (gameState !== 'START') {
                drawPauseBtn();
            }

            if (gameState === 'START') {
                drawStartMenu();
            } else if (isPaused) {
                drawPauseMenu();
            }

            ctx.restore();
        }

        let lastTime = performance.now();
        const targetFps = 60;
        const frameInterval = 1000 / targetFps;
        let accumulatedTime = 0;

        function gameLoop(currentTime) {
            window.fishGameRAF = requestAnimationFrame(gameLoop);

            let deltaTime = currentTime - lastTime;
            lastTime = currentTime;

            if (deltaTime > 200) {
                deltaTime = 200;
            }

            accumulatedTime += deltaTime;

            while (accumulatedTime >= frameInterval) {
                update();
                accumulatedTime -= frameInterval;
            }

            draw();
        }

        window.fishGameRAF = requestAnimationFrame(gameLoop);
    </script>
</body>
</html>
